<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Private Video Call"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/myCallIdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Call ID"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/callIdValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--------"
        android:textSize="24sp"
        android:letterSpacing="0.15"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/partnerCallId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter wife's Call ID"
        android:inputType="text"
        android:maxLength="8"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/startCallButton"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Start Video Call"/>

    <Button
        android:id="@+id/endCallButton"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="End Call"
        android:visibility="gone"
        android:layout_marginTop="12dp"/>

</LinearLayout>
